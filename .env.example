# Copy this file to .env and fill in the values. Never commit .env.

# LLM for the news branch. Any OpenAI-compatible endpoint works.
# Groq (free, no card): https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Upcoming fixtures. Free key: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=
